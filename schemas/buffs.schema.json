            }
          },
          {
            "if": {
              "properties": {
                "rule_type": {
                  "const": "in_mode"
                }
              },
              "required": [
                "rule_type"
              ]
            },
            "then": {
              "properties": {
                "rule_data": {
                  "required": [
                    "float",
                    "string"
                  ],
                  "properties": {
                    "string": {
                      "type": "string",
                      "minLength": 1
